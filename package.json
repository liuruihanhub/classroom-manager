{
  "name": "workbuddy-classroom-manager",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons": "node scripts/generate-icons.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build": "npm run icons && npm run build:standalone && vite build && node scripts/finalize-pwa.mjs",
    "fixture": "node scripts/generate-fixture.mjs",
    "test": "npm run fixture && node --test tests/*.test.mjs",
    "test:all": "npm run build && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "html2canvas": "1.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
